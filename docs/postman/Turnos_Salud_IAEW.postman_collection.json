  "item": [
    {
      "name": "01 - Auth0 Token M2M",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Retorna access_token Bearer\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.access_token).to.be.a(\"string\");",
              "    pm.expect(jsonData.token_type).to.eql(\"Bearer\");",
              "    pm.environment.set(\"accessToken\", jsonData.access_token);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"client_id\": \"{{auth0ClientId}}\",\n  \"client_secret\": \"{{auth0ClientSecret}}\",\n  \"audience\": \"{{auth0Audience}}\",\n  \"grant_type\": \"client_credentials\"\n}"
        },
        "url": {
          "raw": "{{auth0Issuer}}oauth/token",
          "host": [
            "{{auth0Issuer}}oauth"
          ],
          "path": [
            "token"
          ]
        }
      }
