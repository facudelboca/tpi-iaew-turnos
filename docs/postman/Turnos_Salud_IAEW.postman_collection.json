    {
      "name": "06 - Crear Paciente con Datos Dinamicos",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const sufijo = Date.now().toString().slice(-6);",
              "pm.environment.set(\"pacienteDni\", String(30000000 + Math.floor(Math.random() * 50000000)));",
              "pm.environment.set(\"pacienteEmail\", \"paciente\" + sufijo + \"@testsalud.com\");"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Retorna paciente creado con ID\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.id).to.be.a(\"number\");",
              "    pm.environment.set(\"pacienteId\", jsonData.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Carlos\",\n  \"apellido\": \"Gomez\",\n  \"dni\": \"{{pacienteDni}}\",\n  \"email\": \"{{pacienteEmail}}\",\n  \"telefono\": \"3514001122\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/pacientes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "pacientes"
          ]
        }
      }
    },
    {
      "name": "07 - Reservar Turno - Flujo Feliz",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const runId = Date.now() + Math.floor(Math.random() * 100000);",
              "pm.environment.set(\"idempotencyKey\", \"postman-run-\" + runId);",
              "const d = new Date();",
              "const offsetWeeks = 50 + Math.floor(Math.random() * 50);",
              "d.setUTCDate(d.getUTCDate() + offsetWeeks * 7);",
              "while (d.getUTCDay() !== 1) {",
              "    d.setUTCDate(d.getUTCDate() + 1);",
              "}",
              "const y = d.getUTCFullYear();",
              "const m = String(d.getUTCMonth() + 1).padStart(2, '0');",
              "const dia = String(d.getUTCDate()).padStart(2, '0');",
              "const inicio = `${y}-${m}-${dia}T09:00:00.000Z`;",
              "const fin = `${y}-${m}-${dia}T09:30:00.000Z`;",
              "pm.environment.set(\"slotInicio\", inicio);",
              "pm.environment.set(\"slotFin\", fin);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Retorna header X-Correlation-ID\", function () {",
              "    pm.expect(pm.response.headers.has(\"X-Correlation-ID\")).to.be.true;",
              "});",
              "pm.test(\"No es respuesta reproducida\", function () {",
              "    pm.expect(pm.response.headers.get(\"Idempotency-Replayed\")).to.not.eql(\"true\");",
              "});",
              "pm.test(\"Turno reservado correctamente\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.id).to.be.a(\"number\");",
              "    pm.expect(jsonData.estado).to.eql(\"CONFIRMADO\");",
              "    pm.environment.set(\"turnoId\", jsonData.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
