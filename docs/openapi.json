{
  "openapi": "3.1.0",
  "info": {
    "title": "API de Reserva de Turnos de Salud",
    "description": "API REST para administrar profesionales, especialidades, pacientes y turnos de salud, evitando solapamientos horarios de forma transaccional (ACID) y despachando recordatorios asincrónicos vía RabbitMQ.\n\n### Canal en Tiempo Real:\n- **WebSocket de Agenda:** `ws://localhost:3000/ws/agenda` emite eventos en vivo de reservas (`TURNO_RESERVADO`) y cancelaciones (`TURNO_CANCELADO`).",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000/api/v1",
      "description": "Servidor local de desarrollo"
    },
    {
      "url": "/api/v1",
      "description": "Ruta relativa"
    }
  ],
  "tags": [
    {
      "name": "Turnos",
      "description": "Operaciones transaccionales de reserva, consulta y cancelación de turnos"
    },
    {
      "name": "Pacientes",
      "description": "Gestión y alta de pacientes"
    },
    {
      "name": "Profesionales",
      "description": "Consulta de profesionales médicos y sus agendas de atención"
    },
    {
      "name": "Especialidades",
      "description": "Catálogo de especialidades médicas"
    },
    {
      "name": "Administración",
      "description": "Endpoints administrativos asegurados con API Key"
    },
    {
      "name": "Monitoreo",
      "description": "Healthcheck y estado del servicio"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/turnos": {
      "get": {
        "tags": [
          "Turnos"
        ],
        "summary": "Listar turnos con filtros opcionales",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "auth0": [
              "read:turnos"
            ]
          }
        ],
        "parameters": [
          {
            "name": "profesionalId",
            "in": "query",
            "description": "Filtrar por ID de profesional médico",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "pacienteId",
            "in": "query",
            "description": "Filtrar por ID de paciente",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "estado",
            "in": "query",
            "description": "Filtrar por estado del turno",
            "schema": {
              "type": "string",
              "enum": [
                "PENDIENTE",
                "CONFIRMADO",
                "CANCELADO",
                "COMPLETADO"
              ]
            }
          },
          {
            "name": "fecha",
            "in": "query",
            "description": "Filtrar turnos de un día específico (formato YYYY-MM-DD)",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de turnos recuperada exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Turno"
                  }
                }
              }
            }
          },
          "401": {
            "description": "No autenticado o token ausente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Token sin el scope read:turnos requerido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Turnos"
        ],
        "summary": "Reservar turno (transacción multi-paso ACID con idempotencia)",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "auth0": [
              "write:turnos"
            ]
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Clave única de idempotencia para prevenir duplicados ante reintentos de red",
            "schema": {
              "type": "string"
            },
            "example": "reserva-abc-12345"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TurnoInput"
              },
              "example": {
                "pacienteId": 1,
                "profesionalId": 1,
                "especialidadId": 1,
                "fechaHoraInicio": "2026-11-20T09:00:00.000Z",
                "fechaHoraFin": "2026-11-20T09:30:00.000Z",
                "motivoConsulta": "Control cardiovascular anual",
                "canalNotificacion": "EMAIL"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Turno recuperado de forma idempotente (sin duplicación de efectos)",
            "headers": {
              "Idempotency-Replayed": {
                "description": "Indica true al reejecutar con la misma clave de idempotencia",
                "schema": {
                  "type": "boolean"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Turno"
                }
              }
            }
          },
          "201": {
            "description": "Turno confirmado y persistido exitosamente",
            "headers": {
              "Idempotency-Replayed": {
                "description": "Indica false en la primera ejecución",
                "schema": {
                  "type": "boolean"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Turno"
                }
              }
            }
          },
          "400": {
            "description": "Datos de entrada inválidos o inconsistentes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No autenticado o token ausente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Token sin el scope write:turnos requerido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Paciente, profesional o especialidad no encontrados",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "codigo": "PACIENTE_INEXISTENTE",
                  "mensaje": "No se encontró el paciente indicado"
                }
              }
            }
          },
          "409": {
            "description": "Conflicto por turno ocupado, horario fuera de agenda o colisión de idempotencia",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "TurnoOcupado": {
                    "summary": "Solapamiento con otro turno confirmado",
                    "value": {
                      "codigo": "TURNO_OCUPADO",
                      "mensaje": "El profesional ya tiene un turno reservado en ese horario"
                    }
                  },
                  "ProfesionalNoDisponible": {
                    "summary": "Fuera de agenda de atención",
                    "value": {
                      "codigo": "PROFESIONAL_NO_DISPONIBLE",
                      "mensaje": "El profesional no atiende los días seleccionados o en ese horario"
                    }
                  },
                  "IdempotencyMismatch": {
                    "summary": "Clave de idempotencia usada con otro payload",
                    "value": {
                      "codigo": "IDEMPOTENCY_KEY_MISMATCH",
                      "mensaje": "La clave de idempotencia ya fue usada con datos de reserva distintos"
                    }
                  },
                  "IdempotencyReused": {
                    "summary": "Clave de idempotencia ya vinculada a otro turno",
                    "value": {
                      "codigo": "IDEMPOTENCY_KEY_REUSED",
                      "mensaje": "La clave de idempotencia ya fue usada en otro turno"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/turnos/{id}": {
      "get": {
        "tags": [
          "Turnos"
        ],
        "summary": "Obtener detalle de un turno por ID",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "auth0": [
              "read:turnos"
            ]
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TurnoId"
          }
        ],
        "responses": {
          "200": {
            "description": "Detalle del turno encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Turno"
                }
              }
            }
          },
          "401": {
            "description": "No autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Scope insuficiente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Turno no encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Turnos"
        ],
        "summary": "Cancelar un turno",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "auth0": [
              "cancel:turnos"
            ]
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TurnoId"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "motivoCancelacion": {
                    "type": "string",
                    "example": "Solicitado por el paciente"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Turno cancelado exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Turno"
                }
              }
            }
          },
          "400": {
            "description": "Cancelación inválida (turno ya cancelado, completado o pasado)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Scope cancel:turnos ausente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Turno no encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/turnos/{id}/cancelar": {
      "patch": {
        "tags": [
          "Turnos"
        ],
        "summary": "Cancelar un turno (método alternativo PATCH)",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "auth0": [
              "cancel:turnos"
            ]
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TurnoId"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "motivoCancelacion": {
                    "type": "string",
                    "example": "Cancelación administrativa"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Turno cancelado exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Turno"
                }
              }
            }
          },
          "400": {
            "description": "Cancelación inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Turno no encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/pacientes": {
      "get": {
        "tags": [
          "Pacientes"
        ],
        "summary": "Listar pacientes registrados",
        "responses": {
          "200": {
            "description": "Lista de pacientes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Paciente"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Pacientes"
        ],
        "summary": "Registrar un nuevo paciente",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PacienteInput"
              },
              "example": {
                "nombre": "Ana",
                "apellido": "García",
                "dni": "35123456",
                "email": "ana.garcia@example.com",
                "telefono": "+543515551234",
                "obraSocial": "OSDE",
                "numeroAfiliado": "OSDE-987654"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Paciente registrado exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Paciente"
                }
              }
            }
          },
          "400": {
            "description": "Datos de entrada inválidos o faltantes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "DNI o email ya registrado previamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/pacientes/{id}": {
      "get": {
        "tags": [
          "Pacientes"
        ],
        "summary": "Obtener un paciente por ID",
        "parameters": [
          {
            "$ref": "#/components/parameters/PacienteId"
          }
        ],
        "responses": {
          "200": {
            "description": "Paciente encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Paciente"
                }
              }
            }
          },
          "404": {
            "description": "Paciente no encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/profesionales": {
      "get": {
        "tags": [
          "Profesionales"
        ],
        "summary": "Listar profesionales médicos",
        "parameters": [
          {
            "name": "especialidadId",
            "in": "query",
            "description": "Filtrar profesionales por especialidad médica",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de profesionales",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Profesional"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/profesionales/{id}": {
      "get": {
        "tags": [
          "Profesionales"
        ],
        "summary": "Obtener detalle del profesional médico con sus días de atención",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProfesionalId"
          }
        ],
        "responses": {
          "200": {
            "description": "Detalle del profesional con su agenda",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profesional"
                }
              }
            }
          },
          "404": {
            "description": "Profesional no encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/especialidades": {
      "get": {
        "tags": [
          "Especialidades"
        ],
        "summary": "Listar especialidades médicas activas",
        "responses": {
          "200": {
            "description": "Lista de especialidades",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Especialidad"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/especialidades/{id}": {
      "get": {
        "tags": [
          "Especialidades"
        ],
        "summary": "Obtener especialidad por ID",
        "parameters": [
          {
            "$ref": "#/components/parameters/EspecialidadId"
          }
        ],
        "responses": {
          "200": {
            "description": "Especialidad encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Especialidad"
                }
              }
            }
          },
          "404": {
            "description": "Especialidad no encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/admin/sync-especialidades": {
      "post": {
        "tags": [
          "Administración"
        ],
        "summary": "Sincronización administrativa protegida por API Key",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Sincronización administrativa exitosa",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "mensaje": {
                      "type": "string"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "API Key ausente o inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "TurnoId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer"
        },
        "description": "Identificador numérico del turno"
      },
      "PacienteId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer"
        },
        "description": "Identificador numérico del paciente"
      },
      "ProfesionalId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer"
        },
        "description": "Identificador numérico del profesional"
      },
      "EspecialidadId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer"
        },
        "description": "Identificador numérico de la especialidad"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Access Token JWT emitido por Auth0 con scopes correspondientes"
      },
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "API Key para endpoints administrativos internos"
      },
      "auth0": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://facundodelboca.us.auth0.com/authorize",
            "tokenUrl": "https://facundodelboca.us.auth0.com/oauth/token",
            "scopes": {
              "read:turnos": "Consultar turnos y agendas médicas",
              "write:turnos": "Crear y confirmar reservas de turnos",
              "cancel:turnos": "Cancelar turnos existentes",
              "admin:profesionales": "Administración de profesionales y catálogos"
            }
          }
        }
      }
    },
    "schemas": {
      "Paciente": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "nombre": {
            "type": "string"
          },
          "apellido": {
            "type": "string"
          },
          "dni": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "telefono": {
            "type": "string"
          },
          "obraSocial": {
            "type": "string"
          },
          "numeroAfiliado": {
            "type": "string"
          },
          "activo": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "nombre",
          "apellido",
          "dni",
          "email"
        ]
      },
      "PacienteInput": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string"
          },
          "apellido": {
            "type": "string"
          },
          "dni": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "telefono": {
            "type": "string"
          },
          "obraSocial": {
            "type": "string"
          },
          "numeroAfiliado": {
            "type": "string"
          }
        },
        "required": [
          "nombre",
          "apellido",
          "dni",
          "email"
        ]
      },
      "DiaAtencion": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "dia": {
            "type": "string",
            "enum": [
              "LUNES",
              "MARTES",
              "MIERCOLES",
              "JUEVES",
              "VIERNES",
              "SABADO",
              "DOMINGO"
            ]
          },
          "horaInicio": {
            "type": "string",
            "example": "08:00"
          },
          "horaFin": {
            "type": "string",
            "example": "13:00"
          }
        },
        "required": [
          "dia",
          "horaInicio",
          "horaFin"
        ]
      },
      "Profesional": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "nombre": {
            "type": "string"
          },
          "apellido": {
