{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iaew.turnos-salud.test/schemas/turno-reservado-v1.json",
  "title": "turno.reservado v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "type",
    "version",
    "occurredAt",
    "data"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "const": "turno.reservado"
    },
    "version": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turnoId"
      ],
      "properties": {
        "turnoId": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}

